<Window x:Class="AnimeUpscaler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stella-Upscaling" Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0E0B20"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Icon>
        <BitmapImage UriSource="Assets/stella_upscaling_icon.png" />
    </Window.Icon>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/stella_upscaling_logo.png" Width="40" Height="40" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="STELLA UPSCALING" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Perjelas garis dan detail gambar secara lokal — tanpa upload, tanpa internet."
                                Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="14" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#052E2B" BorderBrush="#115E59" BorderThickness="1" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#2DD4BF" Margin="0,0,8,0" />
                        <TextBlock Text="100% OFFLINE" Foreground="#5EEAD4" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" AllowDrop="True"
                    DragOver="Stage_DragOver" Drop="Stage_Drop">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#211B47" Offset="0" />
                        <GradientStop Color="#15132B" Offset="0.55" />
                        <GradientStop Color="#302256" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PanningMode="Both" SizeChanged="ImageScrollViewer_SizeChanged"
                                  PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                        <Grid x:Name="ComparisonStage" ClipToBounds="True" SizeChanged="ComparisonStage_SizeChanged">
                            <!-- Hasil terbaru berada di lapisan bawah. -->
                            <Image x:Name="ResultImage" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                            <!-- Foto lama berada di lapisan atas dan dipotong oleh comparison slider. -->
                            <Border x:Name="BeforeReveal" HorizontalAlignment="Left" ClipToBounds="True">
                                <Image x:Name="OriginalImage" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border x:Name="ComparisonDivider" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                    Background="#FFF9FF" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>

                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="70" Height="70" CornerRadius="35" Background="#202C40" HorizontalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="38" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                                </Border>
                                <TextBlock x:Name="EmptyTitleText" Text="Tarik gambar ke sini" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                                <TextBlock x:Name="EmptySubtitleText" Text="PNG, JPG, JPEG, atau WebP" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="BeforeBadge" Background="#CC0F172A" CornerRadius="7" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Visibility="Collapsed">
                        <TextBlock Text="ORIGINAL" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <Border x:Name="AfterBadge" Background="#CC6D28D9" CornerRadius="7" Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Visibility="Collapsed">
                        <TextBlock Text="HASIL AI" FontSize="11" FontWeight="Bold" />
                    </Border>

                    <Border x:Name="ComparisonControls" VerticalAlignment="Bottom" Margin="18" Padding="14,10" CornerRadius="11" Background="#E6111827" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Original" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider x:Name="ComparisonSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" ValueChanged="ComparisonSlider_ValueChanged" />
                                <TextBlock Grid.Column="2" Text="Hasil AI" Foreground="#C4B5FD" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                                <TextBlock Text="Zoom" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                <Button Content="−" Width="32" Height="28" Padding="0" Click="ZoomOutButton_Click" />
                                <Button x:Name="ZoomResetButton" Content="100%" MinWidth="60" Height="28" Padding="8,0" Margin="6,0" Click="ZoomResetButton_Click" />
                                <Button Content="+" Width="32" Height="28" Padding="0" Click="ZoomInButton_Click" />
                                <TextBlock Text="Ctrl + scroll" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="2,14,2,0">
                <TextBlock x:Name="ImageInfoText" Text="Belum ada gambar" Foreground="{StaticResource Muted}" />
                <TextBlock Text="NCNN Vulkan • AMD / Intel / NVIDIA" Foreground="#64748B" HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Gambar sumber" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <Button x:Name="OpenButton" Content="Pilih Gambar" Margin="0,9,0,0" Click="OpenButton_Click" />
                    <TextBlock x:Name="InputNameText" Text="Belum dipilih" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="2,9,2,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,25,0,0">
                    <TextBlock Text="Model pemrosesan" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <ComboBox x:Name="ModelCombo" Margin="0,9,0,0" SelectionChanged="ModelCombo_SelectionChanged" />
                    <TextBlock x:Name="ModelHintText" Text="" Foreground="#7C8DA6" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Skala" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="ScaleCombo" Margin="0,9,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Format" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <ComboBox x:Name="FormatCombo" Margin="0,9,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3" Margin="0,24,0,0" Background="#101A2A" BorderBrush="#253349" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Siap memproses" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="" HorizontalAlignment="Right" Foreground="#C4B5FD" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" Margin="0,11,0,0" />
                        <TextBlock x:Name="ElapsedText" Text="" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="5">
                    <Button x:Name="UpscaleButton" Content="Upscale Sekarang" Background="{StaticResource Accent}" BorderBrush="#A78BFA" FontSize="15" Padding="14,13" Click="UpscaleButton_Click" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="CancelButton" Content="Batalkan" IsEnabled="False" Click="CancelButton_Click" />
                        <Button x:Name="SaveButton" Grid.Column="2" Content="Simpan Hasil" IsEnabled="False" Click="SaveButton_Click" />
                    </Grid>
                    <TextBlock Text="File diproses di perangkat ini dan tidak pernah diunggah."
                               Foreground="#64748B" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="10,16,10,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
